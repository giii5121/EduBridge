# Copy to .env and fill private credentials. Local demo settings; see README for HTTPS production.
PORT="4000"
HOST="127.0.0.1"
NODE_ENV="development"
APP_ORIGIN="http://127.0.0.1:5173"
TRUST_PROXY="false"
DATABASE_PATH="./data/edubridge.sqlite"
SEED_DEMO="true"
AI_BASE_URL="http://127.0.0.1:8000"
AI_HOST="127.0.0.1"
AI_PORT="8000"
AI_SERVICE_KEY=""
AI_DOCS_ENABLED="true"
LLM_ENABLED="true"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_TIMEOUT_SECONDS="35"
ADMIN_NAME="Operator EduBridge"
ADMIN_EMAIL="operator@edubridge.local"
ADMIN_PASSWORD=""
APP_DOMAIN="localhost"
ALLOW_DEMO_IN_PRODUCTION="false"
