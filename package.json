{
  "name": "edubridge-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup:admin": "npm run setup:admin --workspace server",
    "backup": "npm run backup --workspace server",
    "reset:password": "npm run reset:password --workspace server",
    "dev": "node scripts/stack.mjs --dev",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:ai": "node scripts/ai.mjs",
    "start:ai": "node scripts/ai.mjs",
    "train:ai": "node scripts/train.mjs",
    "build": "npm run build --workspace client",
    "start": "node scripts/stack.mjs",
    "test": "node scripts/with-ai.mjs",
    "test:ml": "node scripts/test-ml.mjs",
    "test:e2e": "node scripts/with-ai.mjs e2e",
    "lint": "npm run lint --workspace client"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "katex": "^0.19.1"
  }
}
